# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/.env.example
/src/generated/prisma/
**/node_modules/
**/dist/
/apps/api/src/generated/
/work/
*.key
*.pfx
*.p12

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.local-media/
/apps/web/public/ocr/

# Local archives and database copies
/apps/web/src.zip
*.dump
*.backup
*.bak
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sql.gz

# Downloaded reference snapshots
/content/sources/**/*.html
