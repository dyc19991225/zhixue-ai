{
  "name": "@zhixue/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node24 --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/app.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@zhixue/shared": "*",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "^8.0.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "redis": "^5.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsup": "9.0.0"
  }
