{
  "name": "zhixue-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web -c cyan,blue \"npm run dev --workspace @zhixue/api\" \"npm run dev --workspace @zhixue/web\"",
    "dev:web": "npm run dev --workspace @zhixue/web",
    "dev:api": "npm run dev --workspace @zhixue/api",
    "build": "prisma generate && npm run build --workspace @zhixue/api && npm run build --workspace @zhixue/web",
    "start:api": "npm run start --workspace @zhixue/api",
    "preview": "npm run preview --workspace @zhixue/web",
    "lint": "eslint apps packages scripts prisma.config.ts",
    "typecheck": "prisma generate && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @zhixue/api",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:check": "tsx scripts/db-check.ts",
    "format": "prettier --write apps packages scripts docs *.json *.ts *.mjs *.md",
    "setup:local": "tsx scripts/setup-local.ts",
    "db:deploy": "prisma migrate deploy",
    "user:promote": "tsx scripts/promote-user.ts",
    "test:auth": "tsx --test apps/api/src/auth/auth.integration.test.ts",
    "test:rbac": "tsx --test apps/api/src/modules/user/user.integration.test.ts",
    "test:relations": "tsx --test apps/api/src/modules/relations/relations.integration.test.ts",
    "test:homework": "tsx --test apps/api/src/modules/homework/homework.integration.test.ts",
    "test:exam": "tsx --test apps/api/src/modules/exam/exam.integration.test.ts",
    "test:analytics": "tsx --test apps/api/src/modules/analytics/analytics.integration.test.ts",
    "test:tasks": "tsx --test apps/api/src/modules/analytics/study-tasks.integration.test.ts",
    "test:teacher-tasks": "tsx --test apps/api/src/modules/analytics/teacher-tasks.integration.test.ts",
    "test:learning": "tsx --test apps/api/src/services/learning.integration.test.ts",
    "test:library": "tsx --test apps/api/src/services/learning-library.integration.test.ts",
    "test:catalog": "tsx --test apps/api/src/services/published-catalog.integration.test.ts",
    "test:journey": "tsx --test apps/api/src/services/student-journey.integration.test.ts",
    "test:review": "tsx --test apps/api/src/modules/course-review/course-review.integration.test.ts",
    "test:review-queue": "tsx --test apps/api/src/modules/course-review/review-queue.integration.test.ts",
    "test:teacher-edit": "tsx --test apps/api/src/modules/relations/teacher-course.integration.test.ts",
    "test:practice": "tsx --test apps/api/src/services/practice.integration.test.ts",
    "test:foundation": "tsx --test apps/api/src/services/foundation.integration.test.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:containers": "tsx scripts/rehearse-containers.ts",
    "db:backup": "tsx scripts/backup.ts",
    "backup:bundle": "tsx scripts/backup-bundle.ts",
    "test:backup": "tsx --test scripts/backup-bundle.test.ts",
    "ops:check": "tsx scripts/check-site.ts",
    "test:ops": "tsx --test scripts/check-site.test.ts",
    "test:ocr": "node scripts/prepare-ocr.mjs && tsx --test scripts/ocr.test.ts",
    "test:crop": "tsx --test scripts/crop-geometry.test.ts",
    "test:question-search": "tsx --test apps/api/src/services/question-search.integration.test.ts",
    "db:restore-check": "tsx scripts/restore-check.ts",
    "content:check": "tsx scripts/content.ts check",
    "content:coverage": "tsx scripts/content-coverage.ts",
    "content:import": "tsx scripts/content.ts import",
    "content:preview": "tsx scripts/content.ts preview",
    "test:content": "tsx --test apps/api/src/services/content.integration.test.ts",
    "assessment:check": "tsx scripts/unit-assessment.ts check",
    "assessment:preview": "tsx scripts/content.ts preview content/assessments/g7-math-linear-unit.v1.json && tsx scripts/unit-assessment.ts prepare",
    "content:link": "tsx scripts/content.ts link",
    "test:diagrams": "tsx --test apps/api/src/services/diagram.integration.test.ts",
    "content:diagram-preview": "tsx scripts/diagram-preview.ts",
    "test:ai-images": "tsx --test apps/api/src/services/ai-image.integration.test.ts",
    "test:photo-correction": "tsx --test scripts/photo-correction.test.ts",
    "test:feedback": "tsx --test apps/api/src/modules/feedback/feedback.integration.test.ts",
    "test:readiness": "tsx --test apps/api/src/services/content-readiness.integration.test.ts",
    "test:lesson-readiness": "tsx --test apps/api/src/services/lesson-readiness.integration.test.ts",
    "test:question-review": "tsx --test apps/api/src/services/question-review.integration.test.ts",
    "test:admin-question-search": "tsx --test apps/api/src/services/admin-question-search.integration.test.ts",
    "build:vps": "node scripts/build-vps-standalone.mjs"
  },
  "overrides": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "globals": "^16.0.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
